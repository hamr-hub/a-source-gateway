# 复制成 .env 并按需修改(.env 已被 .gitignore 忽略, 不会入库)

# ── 服务 ──
A_GATEWAY_HOST=127.0.0.1
A_GATEWAY_PORT=8848

# ── 身份: 强烈建议设置 ──
# 会写进 User-Agent。SEC、OpenAlex 等上游据此识别你; 不带邮箱 SEC 会直接 403。
A_GATEWAY_CONTACT=you@example.com

# ── 预算 ──
A_GATEWAY_BUDGET_MS=500
A_GATEWAY_UPSTREAM_BUDGET_MS=400
A_GATEWAY_RESERVE_MS=100

# ── 缓存 ──
A_GATEWAY_CACHE_ENTRIES=512
A_GATEWAY_CACHE_BYTES=33554432
A_GATEWAY_CACHE_TTL_S=900
A_GATEWAY_PREWARM=1

# ── 行为 ──
# 离线模式: 完全不发网络请求, 只提供元数据与已缓存数据
A_GATEWAY_OFFLINE=0
# 上游传输协议: 1 = 允许 HTTP/2(同一主机的多次调用复用一条连接, 省掉重复握手),
# 0 = 强制 HTTP/1.1 —— 只在某个上游的 h2 实现有问题时才需要关掉。
A_GATEWAY_HTTP2=1
# 仅供自有可信网络; 生产环境不要设成 none
# A_GATEWAY_VERIFY=none
