# a-source-gateway 运行参数样例
#
# 用法:
#   sudo install -d -m 0750 -o root -g a-source-gateway /etc/a-source-gateway
#   sudo install -m 0640 -o root -g a-source-gateway \
#        deploy/systemd/env.example /etc/a-source-gateway/env
#   sudo editor /etc/a-source-gateway/env     # 改成真实值
#
# ⚠️ 这个文件里不要放凭据以外的秘密之外的东西 —— 任何 API key / token
#    同样只走这里(而不是提交进仓库)。文件权限保持 0640。

# ── 服务 ──
A_GATEWAY_HOST=127.0.0.1
A_GATEWAY_PORT=8848
# 事实源目录:装好的包里自带一份(importlib.resources),
# 指向仓库的 data/ 也可以(开发时用)。
# A_GATEWAY_DATA_DIR=/var/lib/a-source-gateway/data

# ── 身份:强烈建议设置 ──
# 会写进 User-Agent。SEC、OpenAlex 等上游据此识别你;不带邮箱 SEC 会直接 403。
# 这是联系邮箱,不是密钥。
A_GATEWAY_CONTACT=you@example.com

# ── 预算 ──
A_GATEWAY_BUDGET_MS=500
A_GATEWAY_UPSTREAM_BUDGET_MS=400
A_GATEWAY_RESERVE_MS=100

# ── 缓存 ──
# 缓存是进程内的(in-process),不落盘、不跨进程共享。
# 重启就是冷缓存。
A_GATEWAY_CACHE_ENTRIES=512
A_GATEWAY_CACHE_BYTES=33554432
A_GATEWAY_CACHE_TTL_S=900
A_GATEWAY_PREWARM=1

# ── 行为 ──
# auto = 有 Python 就用 Python 解析面,否则回落 Go 解析器
# go   = 纯 Go,不拉起 Python worker
A_GATEWAY_PARSER=auto
# 离线模式:完全不发网络请求,只提供元数据与已缓存数据
A_GATEWAY_OFFLINE=0

# ── 上游 API key(按需打开;具体 key 名以 data/source_inventory.csv
#    的「认证方式」列为准,无key 的源不需要)──
# A_GATEWAY_EXAMPLE_SOURCE_API_KEY=
